Menu="Utilities"
Title="VNC Bind"
Icon="icon-virtualization"
Markdown="false"
---
<?php
require_once '/usr/local/emhttp/plugins/VncBind/include/vncbind-lib.php';
$cfg = vncbind_load_cfg();
$csrf = vncbind_csrf_expected();
$saved = array_fill_keys($cfg['interfaces'], true);
$by = [];
foreach (vncbind_host_addrs() as $row) {
    $by[$row['name']][] = $row['addr'];
}
foreach ($cfg['interfaces'] as $name) {
    if (!isset($by[$name])) {
        $by[$name] = [];
    }
}
ksort($by, SORT_NATURAL | SORT_FLAG_CASE);
$choices = vncbind_choices($cfg);
$sug = vncbind_suggestions();
$checked = isset($sug['checked']) ? (int)$sug['checked'] : 0;
$rows = isset($sug['rows']) && is_array($sug['rows']) ? $sug['rows'] : [];
$err = (string)($_GET['err'] ?? '');
$err_text = '';
if ($err === 'check') {
    $err_text = 'Check the selections. Nothing was saved.';
} elseif ($err === 'save') {
    $err_text = 'Could not write the config file.';
}
if (!class_exists('DOMDocument')) {
    $err_text = 'PHP DOM is missing on this server. VNC Bind cannot read or change VM definitions.';
} elseif ($err === 'libvirt') {
    $err_text = 'Libvirt did not answer. Start the VM service and check again.';
}
?>
<?php if ($err_text !== ''): ?>
<p class="vncbind-err"><?= htmlspecialchars($err_text) ?></p>
<?php endif; ?>
<?php if ((string)($_GET['checked'] ?? '') === '1'): ?>
<p>Check finished.</p>
<?php endif; ?>
<form method="post" action="/plugins/VncBind/include/vncbind-save.php" autocomplete="off">
<input type="hidden" name="csrf_token" value="<?= htmlspecialchars($csrf) ?>">
<input type="hidden" name="ifaces_present" value="1">
<dl>
  <dt>Interjection:</dt>
  <dd>
    <select name="interjection">
      <?= mk_option($cfg['interjection'], 'yes', 'Enable') ?>
      <?= mk_option($cfg['interjection'], 'no', 'Disable') ?>
    </select>
  </dd>
</dl>
<blockquote class="inline_help">
  Enable asks which addresses to open before a VM with VNC is created or updated. Disable leaves the save alone.
</blockquote>
<dl>
  <dt>Correct saved VMs:</dt>
  <dd>
    <select name="enforce">
      <?= mk_option($cfg['enforce'], 'yes', 'Yes') ?>
      <?= mk_option($cfg['enforce'], 'no', 'No') ?>
    </select>
  </dd>
</dl>
<blockquote class="inline_help">
  Yes changes a saved VNC listen on every interface to the local console address as soon as libvirt saves it. A VM already running keeps its socket until restart.
</blockquote>
<dl>
  <dt>Use Interface Extra:</dt>
  <dd>
    <select name="use_interface_extra">
      <?= mk_option($cfg['use_interface_extra'], 'yes', 'Yes') ?>
      <?= mk_option($cfg['use_interface_extra'], 'no', 'No') ?>
    </select>
  </dd>
</dl>
<blockquote class="inline_help">
  <a href="/Settings/NetworkExtra">Interface Extra</a> lists interfaces to include and interfaces to exclude. Yes follows that list. No uses only the checked interfaces below.
</blockquote>
<dl>
  <dt>Allowed interfaces:</dt>
  <dd>
<?php if (!$by): ?>
    No interface address is available.
<?php else: ?>
    <div class="vncbind-ifaces">
<?php foreach ($by as $name => $addrs): ?>
      <label><input type="checkbox" name="iface[]" value="<?= htmlspecialchars($name) ?>"<?= isset($saved[$name]) ? ' checked' : '' ?>> <?= htmlspecialchars($name) ?><?php if ($addrs): ?> <?= htmlspecialchars(implode(', ', $addrs)) ?><?php endif; ?></label>
<?php endforeach; ?>
    </div>
<?php endif; ?>
  </dd>
</dl>
<blockquote class="inline_help">
  Checked interfaces appear in the question. None checked offers br0, bond0, eth0, wlan0, and the Interface Extra list when Use Interface Extra is Yes. An Interface Extra exclude is dropped.
</blockquote>
<dl>
  <dt>Offered:</dt>
  <dd>
<?php if (!$choices): ?>
    None
<?php else: ?>
<?php foreach ($choices as $row): ?>
    <div><?= htmlspecialchars($row['name'] . ' ' . $row['addr'] . (vncbind_addr_is_public($row['addr']) ? ' internet' : '')) ?></div>
<?php endforeach; ?>
<?php endif; ?>
  </dd>
</dl>
<blockquote class="inline_help">
  These addresses appear in the question. Each checked address is opened. An internet address stays closed unless it is checked. The console on this server uses the local address. A running VM keeps its current socket until it is restarted.
</blockquote>
<dl>
  <dt>Alerting:</dt>
  <dd>
    <select name="alerting">
      <?= mk_option($cfg['alerting'], 'yes', 'Enable') ?>
      <?= mk_option($cfg['alerting'], 'no', 'Disable') ?>
    </select>
  </dd>
</dl>
<blockquote class="inline_help">
  Enable notifies when an internet address is listed below and a VM VNC listen address is every interface. No password is an alert. A password set is a warning.
</blockquote>
<dl>
  <dt>Internet address:</dt>
  <dd>
<?php $pub = vncbind_internet_addrs(); ?>
<?php if (!$pub): ?>
    No
<?php else: ?>
<?php foreach ($pub as $row): ?>
    <div><?= htmlspecialchars($row['name'] . ' ' . $row['addr']) ?></div>
<?php endforeach; ?>
<?php endif; ?>
  </dd>
</dl>
<blockquote class="inline_help">
  Alerts run when an address is listed here. Tailscale and private LAN addresses are left out.
</blockquote>
<dl>
  <dt>Template check:</dt>
  <dd>
    <select name="schedule">
      <?= mk_option($cfg['schedule'], 'off', 'Off') ?>
      <?= mk_option($cfg['schedule'], 'daily', 'Daily') ?>
      <?= mk_option($cfg['schedule'], 'weekly', 'Weekly') ?>
    </select>
  </dd>
</dl>
<blockquote class="inline_help">
  Daily and Weekly list VMs whose saved or running VNC listen address is every interface. The list does not edit them.
</blockquote>
<dl>
  <dt>&nbsp;</dt>
  <dd>
    <input type="submit" value="Apply">
    <input type="button" value="Done" onclick="done()">
  </dd>
</dl>
</form>
<form method="post" action="/plugins/VncBind/include/vncbind-walk.php" autocomplete="off">
<input type="hidden" name="csrf_token" value="<?= htmlspecialchars($csrf) ?>">
<dl>
  <dt>&nbsp;</dt>
  <dd><input type="submit" value="Check now"></dd>
</dl>
</form>
<?php if ($checked): ?>
<dl>
  <dt>Last check:</dt>
  <dd><?= htmlspecialchars(date('Y-m-d H:i', $checked)) ?></dd>
</dl>
<?php if (!$rows): ?>
<blockquote class="inline_help">
  No VNC listen address is open on every interface.
</blockquote>
<?php else: ?>
<table class="vncbind-suggest">
  <thead>
    <tr><th>VM</th><th>Where</th><th>Listen</th></tr>
  </thead>
  <tbody>
<?php foreach ($rows as $row):
    if (!is_array($row)) continue;
    $where = (string)($row['where'] ?? '');
    $where_label = $where === 'running' ? 'Running' : 'Saved';
    $listen = isset($row['listen']) && is_array($row['listen']) ? implode(', ', array_map('strval', $row['listen'])) : '';
?>
    <tr>
      <td><?= htmlspecialchars((string)($row['domain'] ?? '')) ?></td>
      <td><?= htmlspecialchars($where_label) ?></td>
      <td><?= htmlspecialchars($listen) ?></td>
    </tr>
<?php endforeach; ?>
  </tbody>
</table>
<?php endif; ?>
<?php endif; ?>
